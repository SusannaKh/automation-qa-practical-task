<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation QA Test Suite"
       parallel="classes"
       thread-count="${threadCount}">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="org.example.test.web.LoginTest"/>
            <class name="org.example.test.web.CartTest"/>
            <class name="org.example.test.web.CheckoutTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="org.example.test.api.ApiTests"/>
        </classes>
    </test>

</suite>